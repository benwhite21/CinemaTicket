<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaTicket Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: #0f0f1a;
            color: #e0e0e0;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            width: 220px;
            min-height: 100vh;
            background: #1a1a2e;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
            padding-top: 20px;
        }

            .sidebar .brand {
                color: #e94560;
                font-size: 20px;
                font-weight: bold;
                padding: 0 20px 20px;
                border-bottom: 1px solid #2d2d44;
            }

                .sidebar .brand span {
                    color: white;
                    font-size: 12px;
                    display: block;
                    font-weight: normal;
                }

        .sidebar-section {
            padding: 15px 20px 5px;
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s;
        }

            .sidebar a:hover, .sidebar a.active {
                color: white;
                background: #2d2d44;
                border-left: 3px solid #e94560;
            }

            .sidebar a i {
                width: 16px;
            }

        .main-content {
            margin-left: 220px;
            padding: 25px;
            min-height: 100vh;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .top-bar h4 {
                color: white;
                margin: 0;
            }

        .metric-card {
            background: #1a1a2e;
            border-radius: 10px;
            padding: 20px;
            border: 1px solid #2d2d44;
        }

            .metric-card .value {
                font-size: 28px;
                font-weight: bold;
                color: white;
            }

            .metric-card .label {
                font-size: 13px;
                color: #888;
                margin-bottom: 5px;
            }

            .metric-card .change {
                font-size: 12px;
                margin-top: 8px;
            }

                .metric-card .change.up {
                    color: #4caf50;
                }

                .metric-card .change.down {
                    color: #e94560;
                }

        .card-dark {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 10px;
        }

            .card-dark .card-header {
                background: transparent;
                border-bottom: 1px solid #2d2d44;
                color: white;
                font-weight: bold;
            }

        .table-dark-custom {
            color: #ccc;
        }

            .table-dark-custom th {
                color: #888;
                font-weight: normal;
                font-size: 13px;
                border-color: #2d2d44;
            }

            .table-dark-custom td {
                border-color: #2d2d44;
                font-size: 14px;
                vertical-align: middle;
            }

        .badge-paid {
            background: #1a3a2e;
            color: #4caf50;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .badge-pending {
            background: #3a3a1a;
            color: #ffc107;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .badge-cancelled {
            background: #3a1a1a;
            color: #e94560;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .progress-bar-custom {
            background: #2d2d44;
            border-radius: 4px;
            height: 6px;
            margin-top: 4px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 4px;
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 0;
            width: 100%;
            border-top: 1px solid #2d2d44;
            padding: 10px 0;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="brand">
            🎬 CinemaTicket
            <span>Admin Panel</span>
        </div>

        <div class="sidebar-section">Tổng quan</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="fas fa-th-large"></i> Dashboard
        </a>

        <div class="sidebar-section">Quản lý</div>
        <a asp-area="" asp-controller="Movie" asp-action="Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Movie" ? "active" : "")">
            <i class="fas fa-film"></i> Phim
        </a>
        <a asp-area="" asp-controller="Showtime" asp-action="Index">
            <i class="fas fa-clock"></i> Suất chiếu
        </a>
        <a asp-area="" asp-controller="Cinema" asp-action="Index">
            <i class="fas fa-building"></i> Rạp & Phòng
        </a>
        <a href="#">
            <i class="fas fa-ticket-alt"></i> Vé & Đặt chỗ
        </a>
        <a asp-area="" asp-controller="Account" asp-action="Login">
            <i class="fas fa-users"></i> Người dùng
        </a>

        <div class="sidebar-bottom">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Về trang chủ
            </a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" style="background:none;border:none;width:100%;text-align:left;display:flex;align-items:center;gap:10px;padding:10px 20px;color:#e94560;font-size:14px;cursor:pointer">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>